DEFAULT_LANGUAGE="fr"
DEBUG_MODE=false
PROJECT_NAME="DK_Photographe"

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# * local
DB_TYPE="postgresql"
DATABASE_URL="postgresql://postgres:0000@localhost:5432/backbone?schema=public"
# next auth
AUTH_SECRET="XXX="

# facebook
AUTH_FACEBOOK_ID="xxxxxxxxxxxxxxxxx"
AUTH_FACEBOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# google
AUTH_GOOGLE_ID="944075463183-XXX.XXX.XXX.com"
AUTH_GOOGLE_SECRET="XXX-XXX"

# Github
AUTH_GITHUB_ID="XXX"
AUTH_GITHUB_SECRET="XXX"

AUTH_RESEND_KEY="XXX"

# KV
KV_URL="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KV_REST_API_URL="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KV_REST_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KV_REST_API_READ_ONLY_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

PIN_TTS_TIME=100

MAGIC_LINK_TTS_TIME=30
MAGIC_LINK_RATE_COUNT=1


IMAGE_UPLOAD_URL=http://127.0.0.1:8000

MESSAGE_REQUEST_TTS_TIME=10000
MESSAGE_REQUEST_RATE_COUNT=10